{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "tender-a-library/latest-books",
  "version": "0.1.0",
  "title": "Latest Books",
  "category": "tender-blocks",
  "icon": "books",
  "description": "Display the latest books added to the library in a responsive grid.",
  "attributes": {
    "booksToShow": {
      "type": "number",
      "default": 6
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": true
  },
  "textdomain": "tender-library",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}